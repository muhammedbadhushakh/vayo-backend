rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same admin check as firestore.rules, using Storage's cross-service
    // access to Firestore (works automatically within the same project).
    function isAdmin() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Every image upload across the admin panel is capped at 15MB.
    function isValidImage() {
      return request.resource.size < 15 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }
    // Instagram/Facebook manager also accepts short video clips, capped at 25MB.
    function isValidVideo() {
      return request.resource.size < 25 * 1024 * 1024
             && request.resource.contentType.matches('video/.*');
    }

    // Product photos — public read, admin-only upload.
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Category cover images — public read, admin-only upload.
    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Homepage / promo banner images — public read, admin-only upload.
    match /banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Store logo(s) — public read, admin-only upload.
    match /logos/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Homepage hero images (desktop/mobile) — public read, admin-only upload.
    match /homepage/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Instagram manager media (image up to 15MB, or short video up to 25MB).
    match /instagram/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && (isValidImage() || isValidVideo());
    }

    // Facebook manager media (image up to 15MB, or short video up to 25MB).
    match /facebook/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && (isValidImage() || isValidVideo());
    }

    // Favicons — public read, admin-only upload.
    match /favicons/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Shopper profile photos — each shopper manages only their own
    // folder (path must start with their uid); admins can manage all.
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == uid || isAdmin()) && isValidImage();
    }
  }
}
