rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // An "admin" is any signed-in user whose uid has a matching
    // document in the /admins collection. Create this doc yourself
    // in the Firebase Console (Firestore -> admins -> Add document
    // -> Document ID = the admin's Auth UID, any field e.g. role:"admin").
    // This is what separates the one shop-owner login from every
    // shopper who signs up on the storefront using the same
    // Authentication provider.
    // ---------------------------------------------------------
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admin allow-list. isAdmin() above uses exists() which bypasses these
    // rules entirely, so tightening this doesn't break that check — this
    // just controls whether the *app* can read/write the collection
    // directly. A signed-in user may read only their own doc (so the
    // admin dashboard can confirm "am I an admin?" on load); only an
    // existing admin can add/remove other admins.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Products — anyone can browse; only admins manage.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories — anyone can browse; only admins manage.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners (homepage promo banners) — public read, admin write.
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons — validated at checkout, so shoppers need read access to
    // check a code's validity; only admins can create/edit/delete.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews — public read; a signed-in shopper may create their own
    // review; only admins can edit/delete (moderation) or approve.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Instagram feed posts (Admin -> Instagram Manager) — public read,
    // admin-only write.
    match /instagramPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Facebook promo posts (Admin -> Facebook Manager) — public read,
    // admin-only write.
    match /facebookPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website / shipping / payment settings — public read (storefront
    // needs shipping rules, store name, etc.), admin-only write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — the browser never writes an order document directly.
    // Checkout goes through the verify-payment Netlify Function, which
    // uses the Firebase Admin SDK (a trusted server context that
    // bypasses these rules entirely) to save the order ONLY after the
    // Razorpay payment signature has been verified. From the client's
    // side, a shopper may only read their own orders; admins can read,
    // update (status/tracking) and delete any order.
    match /orders/{orderId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || (request.auth != null && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Wishlist — one doc per shopper (doc id = uid). Only that shopper
    // (or an admin) can read/write it.
    match /wishlist/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Customer profile records (optional, mirrors Firebase Auth users
    // for the admin panel's Customers tab) — a shopper can read/update
    // their own profile; admins can read/manage every customer.
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
    }
  }
}
